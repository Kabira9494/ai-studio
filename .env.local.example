# Copy this file to ".env.local" and fill in the values.
# Your real .env.local is kept out of git by .gitignore — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────
# Your Replicate token. Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_token_here

# ── Recommended before sharing a link ─────────────────────────────────────────
# An access code people must enter to use the generator. Share it only with
# people you want generating on your credits. Leave blank to allow anyone.
APP_PASSWORD=

# ── Optional: real per-visitor rate limiting ──────────────────────────────────
# Create a free Redis database at https://upstash.com and paste the REST URL and
# token here. If both are blank, rate limiting is skipped (access code still works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
